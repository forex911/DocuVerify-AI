# DocuVerify AI Environment Configuration

# Database Configuration (SQLite default for local development)
DATABASE_URL=sqlite:///./docuverify.db

# File Upload Settings
MAX_UPLOAD_SIZE_BYTES=10485760

# Optional Tesseract OCR Settings
OCR_ENABLED=true
# Windows path example: C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=

# Optional Gemini Integration (Isolated assistant; backend fully operational without key)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Deterministic Validation Tolerances (Decimal)
FINANCIAL_TOLERANCE=0.00
QUANTITY_TOLERANCE=0.00

